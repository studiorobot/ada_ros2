<?xml version="1.0"?>
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="ada"
>
  <xacro:arg
    name="initial_positions_file"
    default="initial_positions.yaml"
  />
  <xacro:arg
    name="sim"
    default="real"
  />
  <xacro:arg
    name="robot_ip"
    default="192.168.1.10"
  />
  <xacro:arg
    name="use_fake_hardware"
    default="${'$(arg sim)' != 'real'}"
  />

  <!-- Import ada urdf file -->
  <xacro:include filename="$(find ada_description)/urdf/ada.xacro"/>

  <!-- Import control_xacro -->
  <xacro:include filename="ada.ros2_control.xacro"/>

  <!-- Only add the ADAHardware ros2_control for simulation modes.
       For real hardware (sim='real'), KortexMultiInterfaceHardware from ada_description 
       handles the robot when use_fake_hardware=false.
       Adding both causes duplicate interface registration. -->
  <xacro:unless value="${'$(arg sim)' == 'real'}">
    <xacro:ada_ros2_control
      name="ADAHardware"
      initial_positions_file="$(arg initial_positions_file)"
      sim="$(arg sim)"
      robot_ip="$(arg robot_ip)"
    />
  </xacro:unless>
</robot>
